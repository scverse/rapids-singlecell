root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[{*.yml,*.yaml,*.toml,.cruft.json}]
indent_size = 2

# formatted by taplo (see .taplo.toml)
[{hatch.toml,src/**/*.toml}]
indent_size = 4

[Makefile]
indent_style = tab
